# ==========================================================================
# ERP — Environment template. Copy to .env and fill in. NEVER commit .env.
# All secrets come from the environment (spec #41). No secret has a real
# default value here.
# ==========================================================================

APP_NAME="ERP"
APP_ENV=local
APP_KEY=                      # generated by `php artisan key:generate`
APP_DEBUG=true                # MUST be false in production (spec #67: no stack traces to users)
APP_URL=http://localhost:8080
APP_TIMEZONE=UTC              # store UTC; display per company/user (spec #53)

# --- Locale / Bangladesh-ready defaults (all configurable, not hard-coded — spec #40) ---
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
DEFAULT_CURRENCY=BDT
DEFAULT_CURRENCY_SYMBOL=৳
CURRENCY_PRECISION=2          # monetary decimal places
QUANTITY_PRECISION=4          # quantity decimal places
COST_PRECISION=6             # unit-cost precision for weighted-average (spec #15)

# --- Database (PostgreSQL — spec #27) ---
DB_CONNECTION=pgsql
DB_HOST=postgres              # docker-compose service name
DB_PORT=5432
DB_DATABASE=erp
DB_USERNAME=erp_app           # restricted application role (NOT superuser — spec #10)
DB_PASSWORD=                  # set a strong value; required

# Separate superuser creds are used ONLY by migrations/backup, never by the app runtime.
DB_ROOT_USERNAME=erp_owner
DB_ROOT_PASSWORD=

# --- Sessions / cache / queue (all local, $0) ---
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false   # true behind HTTPS in production
CACHE_STORE=database
QUEUE_CONNECTION=database

# --- Mail: OPTIONAL adapter. App must work without it (spec #39). ---
MAIL_MAILER=log               # 'log' = no external service. Swap to smtp only if configured.

# --- Filesystem: local by default; S3-compatible is an optional swap (spec #38). ---
FILESYSTEM_DISK=local

# --- Security / auth ---
BCRYPT_ROUNDS=12
